# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# --- Banco MySQL ---------------------------------------------------------
# No MySQL instalado no Windows (Workbench), normalmente é porta 3306 e o
# usuário root com a senha que você definiu na instalação.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=refood
# banco separado que os testes (pytest) apagam e recriam
DB_NAME_TESTE=refood_teste

# --- Login ----------------------------------------------------------------
# Chave que assina os tokens. Gere uma aleatória com pelo menos 32 caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque_por_uma_chave_aleatoria_de_pelo_menos_32_caracteres
JWT_EXPIRA_HORAS=12
