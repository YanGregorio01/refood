entes. Quem liga um ao outro é o database ponto pai, a ponte."},"07":{"texto":"Antes de rodar reservar, o FastAPI resolve as dependências: os parâmetros com Depends. A primeira é o guét dê bê. Ele usa o pai-mai-ésse-quê-éle para abrir uma conexão com o banco, com as linhas vindo como dicionário, e com o autocommit desligado: nada é gravado sem commit. A conexão é entregue com iíld, e fica aberta até a resposta sair.","dur":26.703,"letras":[0,0.197,0.279,0.325,0.395,0.43,0.476,0.499,0.534,0.592,0.639,0.708,0.789,0.859,0.882,0.917,0.952,1.01,1.08,1.138,1.207,1.277,1.393,1.498,1.591,1.741,1.788,1.858,1.892,2.009,2.055,2.136,2.287,2.357,2.426,2.461,2.508,2.589,2.67,2.786,2.868,2.926,2.995,3.03,3.077,3.111,3.158,3.181,3.251,3.297,3.367,3.413,3.471,3.553,3.611,3.669,3.704,3.785,3.901,4.04,4.168,4.272,4.331,4.423,4.47,4.551,4.621,4.702,4.76,4.818,4.876,4.934,5.016,5.062,5.271,5.317,5.422,5.596,5.956,6.072,6.211,6.304,6.444,6.502,6.583,6.722,6.931,7.07,7.14,7.221,7.256,7.303,7.361,7.419,7.454,7.5,7.57,7.628,7.721,7.883,8.15,8.266,8.371,8.406,8.452,8.568,8.615,8.661,8.684,8.742,8.824,8.882,9.079,9.195,9.392,9.497,9.578,9.613,9.659,9.799,9.915,9.961,10.008,10.043,10.112,10.17,10.286,10.298,10.356,10.391,10.484,10.553,10.6,10.681,10.716,10.762,10.809,10.855,10.89,10.948,11.064,11.099,11.122,11.204,11.355,11.552,11.633,11.703,11.761,11.784,11.807,11.854,11.923,11.981,12.063,12.098,12.144,12.179,12.225,12.26,12.295,12.33,12.388,12.434,12.516,12.666,12.783,12.817,12.852,12.899,12.968,13.015,13.038,13.05,13.119,13.177,13.293,13.328,13.398,13.526,13.607,13.77,13.804,13.862,13.886,13.955,14.013,14.048,14.153,14.187,14.257,14.304,14.362,14.42,14.455,14.547,14.582,14.722,14.814,14.884,14.965,15.07,15.116,15.209,15.314,15.523,15.825,15.941,16.057,16.115,16.173,16.242,16.335,16.451,16.533,16.568,16.684,16.718,16.893,17.009,17.078,17.113,17.16,17.194,17.276,17.299,17.345,17.427,17.508,17.589,17.659,17.717,17.798,17.845,17.891,18.007,18.042,18.158,18.193,18.251,18.321,18.39,18.448,18.53,1